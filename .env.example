FLASK_APP=wsgi.py
FLASK_ENV=development

# Gere cada uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção a aplicação RECUSA subir com menos de 32 bytes.
SECRET_KEY=TROQUE-ME
JWT_SECRET_KEY=TROQUE-ME

JWT_ACCESS_MINUTOS=30
JWT_REFRESH_DIAS=7

SQLITE_PATH=laac_lab.db

# Vitrine da home. 1 fala com a Steam (sem chave). 0 desliga.
# RAWG_API_KEY, se preenchida, troca os destaques da loja pela RAWG.
VITRINE_EXTERNA=1
RAWG_API_KEY=

MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=laac_lab

# RAWG (imagens e importação de jogos). Chave gratuita em https://rawg.io/apidocs
# Fica só no back-end: nunca vai para HTML, JS, respostas da API ou logs.
RAWG_API_KEY=
RAWG_BASE_URL=https://api.rawg.io/api
RAWG_TIMEOUT=10
